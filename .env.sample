# Google sign-in: use the client ID configured in Recall.
GOOGLE_OAUTH_CLIENT_ID=
# Optional override; defaults to https://{RECALL_REGION}.recall.ai/api/v1/calendar/google_oauth_callback/
GOOGLE_OAUTH_REDIRECT_URI=

# Microsoft sign-in: use the Application (client) ID configured in Recall.
MICROSOFT_OAUTH_CLIENT_ID=
# Optional override; defaults to https://{RECALL_REGION}.recall.ai/api/v1/calendar/ms_oauth_callback/
MICROSOFT_OAUTH_REDIRECT_URI=

# Required: API key for the Recall workspace in the region below.
RECALL_API_KEY=
# Use your Recall dashboard's region.
RECALL_REGION=us-east-1
RECALL_USER_ID=local-demo-user

# Set at least one provider client ID. Store provider secrets and certificates in Recall.
