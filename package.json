{
  "name": "calendar-v1-sample-app",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others \"pnpm dev:server\" \"pnpm dev:client\"",
    "dev:server": "WATCHPACK_POLLING=true next dev --webpack --port 3001 --hostname 127.0.0.1",
    "dev:client": "pnpm --dir client dev",
    "build": "next build && pnpm --dir client build",
    "start": "next start --port 3001 --hostname 127.0.0.1",
    "lint": "pnpm --dir client lint"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^9.1.0",
    "typescript": "~6.0.2"
  },
  "dependencies": {
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
